GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-4-argon

# Registration Mode:
# 'open'        — Anyone can register and create their own organization (default in development).
# 'invite_only' — Registration strictly requires an unexpired, unused invitation code (default in production).
REGISTRATION_MODE=open


# Vision Preprocessing Service (Optional — disabled by default)
VISION_PIPELINE_ENABLED=false
VISION_SERVICE_URL=http://127.0.0.1:8765
VISION_FAIL_OPEN=true
VISION_REQUEST_TIMEOUT_SECONDS=60
