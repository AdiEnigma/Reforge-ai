GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.6-flash


# Vision Preprocessing Service (Optional — disabled by default)
VISION_PIPELINE_ENABLED=false
VISION_SERVICE_URL=http://127.0.0.1:8765
VISION_FAIL_OPEN=true
VISION_REQUEST_TIMEOUT_SECONDS=60

# Dataset-first retrieval (independent Python service; fails open to Gemini)
DATASET_RETRIEVAL_ENABLED=true
DATASET_FIRST=true
DATASET_SERVICE_URL=http://127.0.0.1:8767
DATASET_REQUEST_TIMEOUT_SECONDS=20
DATASET_FAIL_OPEN=true
DATASET_STORAGE_PATH=backend/var/datasets
DATASET_MATCH_THRESHOLD=0.82
DATASET_VIEWER_MAX_TRIANGLES=50000
