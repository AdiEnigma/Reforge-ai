GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.6-flash


# Vision Preprocessing Service (Optional — disabled by default)
VISION_PIPELINE_ENABLED=false
VISION_SERVICE_URL=http://127.0.0.1:8765
VISION_FAIL_OPEN=true
VISION_REQUEST_TIMEOUT_SECONDS=60

# Python CAD Engine (python-engine/app.py)
CAD_ENABLED=false
CAD_SERVICE_URL=http://127.0.0.1:8766
CAD_TIMEOUT_SECONDS=120
# Directory where generated artefacts are staged for download (default: backend/var/cad)
# CAD_STORE_DIR=
# Hours before staged CAD jobs are deleted
CAD_JOB_TTL_HOURS=24
# Route non-gear revolved/extruded/combination recipes through the feature pipeline
CAD_ADVANCED_ENABLED=false

# Reconstruction service (optional)
RECONSTRUCTION_ENABLED=false
RECONSTRUCTION_SERVICE_URL=http://127.0.0.1:8766
RECONSTRUCTION_TIMEOUT_SECONDS=60
# RECONSTRUCTION_IMAGE_ROOT=

# Job orchestration (in-memory)
JOB_TTL_SECONDS=1800
JOB_MAX_ENTRIES=50

# Opt-in analysis logging for a future dataset (requires per-request consent)
ANALYSIS_LOG_ENABLED=false
# ANALYSIS_LOG_DIR=backend/var/analysis-log
ANALYSIS_LOG_RETENTION_DAYS=30
# Store raw photos too (only with a reviewed consent notice)
ANALYSIS_LOG_INCLUDE_IMAGES=false

# Comma-separated browser origins allowed by CORS
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
